# MANLE Docker stack
COMPOSE_PROJECT_NAME=manle

# Public ports on the host
FE_PORT=5175
ADMIN_PORT=5176
API_PORT=8790
POSTGRES_PORT=5435
REDIS_PORT=6380

# Browser-facing host. compose.yaml builds origins from this host + *_PORT.
PUBLIC_ORIGIN_HOST=127.0.0.1
# Optional comma-separated extra browser origins allowed by the API CORS policy.
CORS_ORIGINS=

# API runtime
API_HOST=0.0.0.0
SESSION_COOKIE_NAME=manle_session
REFRESH_COOKIE_NAME=manle_refresh
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false

# Postgres
POSTGRES_DB=manle
POSTGRES_USER=manle
POSTGRES_PASSWORD=manle

# Redis
REDIS_PASSWORD=

# Paddle secrets stay empty locally unless billing integration is enabled
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
