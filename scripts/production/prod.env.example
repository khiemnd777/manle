COMPOSE_PROJECT_NAME=manle

# Image coordinates are normally provided by GitHub Actions.
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=your-github-owner-lowercase
IMAGE_TAG=v2026.05.17

# Host port bindings. Keep 127.0.0.1 when a host reverse proxy terminates TLS.
API_BIND=127.0.0.1
API_PORT=8787
FE_BIND=127.0.0.1
FE_PORT=5173
ADMIN_BIND=127.0.0.1
ADMIN_PORT=5174

# Public browser origins.
FE_ORIGIN=https://manle.info
ADMIN_ORIGIN=https://admin.manle.info
CORS_ORIGINS=
PROD_HEALTHCHECK_URL=https://api.manle.info/health

# API runtime.
SESSION_COOKIE_NAME=manle_session
REFRESH_COOKIE_NAME=manle_refresh
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=true

# Postgres. DATABASE_URL must match the compose service credentials or a managed database URL.
POSTGRES_DB=manle
POSTGRES_USER=manle
POSTGRES_PASSWORD=replace-with-production-password
DATABASE_URL=postgres://manle:replace-with-production-password@postgres:5432/manle

# Redis. Leave as the compose service URL unless using managed Redis.
REDIS_URL=redis://redis:6379

# Paddle production billing.
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
