# Copy this file to .github-secrets.env, fill values locally, then run:
# scripts/sync-github-secrets.sh .github-secrets.env
#
# Use @path values for multiline or sensitive files. Values are stored as GitHub
# Environment secrets under "production"; real files stay local and ignored.

PROD_HOST=your-vps-host-or-ip
PROD_USER=your-vps-ssh-user
PROD_SSH_PORT=22
PROD_SSH_KEY=@./.secrets/prod_deploy_key
PROD_SSH_PASSWORD=@./.secrets/prod_ssh_password
PROD_SSH_KNOWN_HOSTS=@./.secrets/prod_known_hosts
PROD_DEPLOY_PATH=/path/to/manle
PROD_ENV_FILE=@./.env.prod
PROD_HEALTHCHECK_URL=https://api.example.com/health
PROD_VITE_API_BASE_URL=https://api.example.com
PROD_CERTBOT_EMAIL=admin@example.com
PROD_SUDO_PASSWORD=@./.secrets/prod_sudo_password

# Required when GHCR packages are private on the production server.
PROD_GHCR_USERNAME=github-user-or-bot
PROD_GHCR_TOKEN=@./.secrets/ghcr_read_packages_token
